# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/atsbot

# Gemini API Key (or OpenAI API Key depending on implementation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port for express server (if needed for webhooks later)
PORT=3000
